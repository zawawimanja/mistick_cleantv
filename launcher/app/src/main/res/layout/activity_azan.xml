<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8080B10"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_prayer_card"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <ImageView
            android:id="@+id/azanIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_solat_isha"
            android:tint="#FFFFFFFF"
            android:contentDescription="Solat Icon" />

        <TextView
            android:id="@+id/azanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="WAKTU SOLAT"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.06"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/azanLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kuala Lumpur (WLY01)"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_regular" />

        <View
            android:layout_width="140dp"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hormati Panggilan Azan"
            android:textColor="#FFE082"
            android:textSize="15sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/azanSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tekan sebarang butang remote untuk tutup / sambung semula"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_regular" />
    </LinearLayout>
</FrameLayout>
